{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wpcamp-hub/stats",
	"version": "1.0.0",
	"title": "Stats Band",
	"category": "design",
	"icon": "chart-bar",
	"description": "Festival stats band — a row of count-up counters. Add, remove and reorder stats freely.",
	"keywords": [ "stats", "counters", "numbers", "festival" ],
	"textdomain": "wpcamp-hub",
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "full" ],
		"spacing": {
			"padding": true,
			"margin": true
		}
	},
	"attributes": {
		"columns": {
			"type": "number",
			"default": 4
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}

{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wpcamp-hub/hero-section",
	"version": "1.0.0",
	"title": "Hero Section",
	"category": "design",
	"icon": "megaphone",
	"description": "WPCAMP-HUB festival hero — link an event to pull its date, location, attendees and ticket link, or set the fields manually.",
	"keywords": [ "hero", "header", "festival", "wceu", "event" ],
	"textdomain": "wpcamp-hub",
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "full" ],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"attributes": {
		"eventId": {
			"type": "number"
		},
		"eyebrow": {
			"type": "string",
			"default": ""
		},
		"location": {
			"type": "string",
			"default": ""
		},
		"heading": {
			"type": "string",
			"default": "The community gets together."
		},
		"lead": {
			"type": "string",
			"default": "Three days of talks, workshops, late-night meetups and the people who make the open web. Everyone's welcome — from your first site to core."
		},
		"dateLabel": {
			"type": "string",
			"default": ""
		},
		"showBadge": {
			"type": "boolean",
			"default": true
		},
		"goingSubtext": {
			"type": "string",
			"default": "Join your people"
		},
		"ticketsLabel": {
			"type": "string",
			"default": "Get tickets"
		},
		"exploreLabel": {
			"type": "string",
			"default": "Explore events"
		},
		"imageId": {
			"type": "number"
		},
		"imageUrl": {
			"type": "string"
		},
		"imageAlt": {
			"type": "string",
			"default": ""
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}

{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wpcamp-hub/hero-section",
	"version": "1.0.0",
	"title": "Hero Section",
	"category": "design",
	"icon": "megaphone",
	"description": "WPCAMP-HUB festival hero — eyebrow, headline, lead, calls to action and a decorative collage.",
	"keywords": [ "hero", "header", "festival", "wceu" ],
	"textdomain": "wpcamp-hub",
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "full" ],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"attributes": {
		"eyebrow": {
			"type": "string",
			"source": "html",
			"selector": ".wpch-hero__eyebrow",
			"default": "WordCamp Europe 2026"
		},
		"location": {
			"type": "string",
			"source": "html",
			"selector": ".wpch-hero__pill-label",
			"default": "Lisbon"
		},
		"heading": {
			"type": "string",
			"source": "html",
			"selector": ".wpch-hero__title",
			"default": "The community gets together."
		},
		"lead": {
			"type": "string",
			"source": "html",
			"selector": ".wpch-hero__lead",
			"default": "Three days of talks, workshops, late-night meetups and the people who make the open web. Everyone's welcome — from your first site to core."
		},
		"whenText": {
			"type": "string",
			"source": "html",
			"selector": ".wpch-hero__when",
			"default": "12–14 June 2026"
		},
		"dateLabel": {
			"type": "string",
			"source": "html",
			"selector": ".wpch-hero__date",
			"default": "12–14 June 2026"
		},
		"showBadge": {
			"type": "boolean",
			"default": true
		},
		"goingText": {
			"type": "string",
			"source": "html",
			"selector": ".wpch-hero__going-count",
			"default": "+2,500 going"
		},
		"goingSubtext": {
			"type": "string",
			"source": "html",
			"selector": ".wpch-hero__going-sub",
			"default": "Join your people"
		},
		"imageId": {
			"type": "number"
		},
		"imageUrl": {
			"type": "string",
			"source": "attribute",
			"selector": ".wpch-hero__img",
			"attribute": "src"
		},
		"imageAlt": {
			"type": "string",
			"source": "attribute",
			"selector": ".wpch-hero__img",
			"attribute": "alt",
			"default": ""
		},
		"avatars": {
			"type": "array",
			"default": [],
			"source": "query",
			"selector": ".wpch-hero__avatar-img",
			"query": {
				"url": {
					"type": "string",
					"source": "attribute",
					"attribute": "src"
				},
				"alt": {
					"type": "string",
					"source": "attribute",
					"attribute": "alt",
					"default": ""
				},
				"id": {
					"type": "number",
					"source": "attribute",
					"attribute": "data-id"
				}
			}
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
